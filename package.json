{
  "name": "sreon-browser",
  "productName": "SREON Browser",
  "version": "0.1.0",
  "description": "A lightweight desktop browser with a reliable startup experience",
  "main": "src/main.js",
  "author": "SREON Browser contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sreon.browser",
    "productName": "SREON Browser",
    "artifactName": "SREON-Browser-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "dmg": {
      "title": "SREON Browser ${version}"
    },
    "publish": null
  }
}
